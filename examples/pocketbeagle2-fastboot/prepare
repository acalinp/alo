#!/usr/bin/env bash
set -Eeuo pipefail

infrastructure() {
	local message=$1
	shift
	if ! "$@"; then
		echo "infrastructure failure: $message" >&2
		exit 2
	fi
}

for command in lsusb timeout; do
	command -v "$command" >/dev/null || {
		echo "infrastructure failure: missing host command $command" >&2
		exit 2
	}
done
echo "USB devices before reset:"
lsusb 2>&1 || true
echo

infrastructure "board reset failed or timed out" timeout --foreground 10s ./tools/reset.sh
sleep 0.5

echo "USB devices after reset:"
lsusb 2>&1 || true
