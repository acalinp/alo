#!/bin/sh
# Boot a PocketBeagle 2 from the AM62x ROM USB-DFU mode into U-Boot fastboot.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
DFU="$ROOT/.alo/bin/dfu-util"
export LD_LIBRARY_PATH="$ROOT/.alo/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

is_fastboot() {
    for i in /sys/bus/usb/devices/*:*; do
        [ -r "$i/bInterfaceClass" ] || continue
        [ "$(cat "$i/bInterfaceClass")" = ff ] || continue
        [ "$(cat "$i/bInterfaceSubClass")" = 42 ] || continue
        [ "$(cat "$i/bInterfaceProtocol")" = 03 ] || continue
        return 0
    done
    return 1
}

wait_alt() {
    alt=$1
    n=0
    while [ "$n" -lt 80 ]; do
        is_fastboot && return 2
        if "$DFU" -d 0451:6165 -l 2>&1 | grep -Fq "name=\"$alt\""; then
            return 0
        fi
        n=$((n + 1))
        sleep 0.25
    done
    echo "Timed out waiting for PocketBeagle 2 DFU target '$alt'" >&2
    return 1
}

upload() {
    alt=$1
    image=$2
    reset=${3:-yes}
    echo "Loading $image as $alt"
    # The ROM launches tiboot3 on manifestation and must not receive a USB
    # reset. The two SPL stages require one, as documented for AM62x DFU boot.
    # A stage normally disconnects before dfu-util reads its final status.
    if [ "$reset" = yes ]; then
        "$DFU" -d 0451:6165 -a "$alt" -D "$ROOT/artifacts/$image" -R || true
    else
        "$DFU" -d 0451:6165 -a "$alt" -D "$ROOT/artifacts/$image" || true
    fi
}

if is_fastboot; then
    echo "PocketBeagle 2 is already in fastboot mode"
    exit 0
fi

wait_alt bootloader
upload bootloader tiboot3.bin noreset
wait_alt tispl.bin
upload tispl.bin tispl.bin
wait_alt u-boot.img
upload u-boot.img u-boot.img

n=0
while [ "$n" -lt 120 ]; do
    if is_fastboot; then
        echo "PocketBeagle 2 fastboot is ready"
        exit 0
    fi
    n=$((n + 1))
    sleep 0.25
done

echo "U-Boot was loaded, but its fastboot USB interface did not appear" >&2
exit 1
