FROM docker.io/library/node:24-bookworm

ARG PI_VERSION=0.84.4

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    file \
    git \
    jq \
    openssh-client \
    pkg-config \
    python3 \
    python3-pip \
    rsync \
    sudo \
    unzip \
    xz-utils \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g --ignore-scripts "@earendil-works/pi-coding-agent@${PI_VERSION}" \
 && printf 'node ALL=(ALL) NOPASSWD:ALL\n' >/etc/sudoers.d/node \
 && chmod 0440 /etc/sudoers.d/node

COPY run-agent /usr/local/bin/alo-agent
COPY instructions.md /usr/local/share/alo-agent-instructions.md
RUN chmod 0755 /usr/local/bin/alo-agent

USER node
ENV PI_CODING_AGENT_DIR=/session/pi
WORKDIR /work
